# Copy this file to `.env` and fill in real values:
#   cp .env.example .env

# Secret used to protect the /admin page and admin API.
# Generate a long random string, e.g.:
#   openssl rand -hex 24
ADMIN_SECRET=change-me

# Optional: override the SQLite database file location (relative to project root).
# Defaults to ./data/secret-santa.db
# DB_PATH=./data/secret-santa.db
